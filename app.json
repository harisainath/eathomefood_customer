{
  "expo": {
    "name": "EatHomeFood",
    "slug": "eathomefood-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFC529",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eathomefood.customer",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.eathomefood.customer",
      "adaptiveIcon": {
        "backgroundColor": "#FFC529"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EatHomeFood uses your location to show restaurants that deliver to you."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyAGfdbaAW-2m4SgehbGuLTRtjWFECf9pXw"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFC529"
        }
      ]
    ]
  }
}